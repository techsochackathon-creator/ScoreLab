// Prisma schema — AI-based hackathon evaluation (Next.js + Vercel + Neon).
//
// Datasource uses Vercel's standard Postgres/Neon env vars:
//   url       -> POSTGRES_PRISMA_URL      (pooled; runtime)
//   directUrl -> POSTGRES_URL_NON_POOLING (direct; migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ---------------------------------------------------------------------------
// Auth (organizer login)
// ---------------------------------------------------------------------------

enum Role {
  ORGANIZER
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  name         String?
  passwordHash String
  role         Role   @default(ORGANIZER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id         String   @id @default(cuid())
  teamCode   String   @unique
  name       String
  university String
  track      String
  memberNames String[]

  // Optional project profile (shown on the team detail page).
  projectTitle       String?
  projectDescription String?
  technologies       String[] @default([])
  /// Canonical repository for batch evaluation.
  repoUrl            String?

  submissions      Submission[]
  evaluationEvents EvaluationEvent[]
  batchJobs        BatchJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([track])
}

/// Immutable evaluation version/run record. Append-only: every evaluation run
/// (including re-runs and gated/failed outcomes) creates a NEW row and never
/// overwrites an older one. Preserves exactly what produced each result for
/// auditability. Also powers the history timeline and leaderboard trend deltas.
model EvaluationEvent {
  id           String      @id @default(cuid()) // evaluation ID
  teamId       String
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  repoUrl           String?
  commitSha         String?
  evidenceFetchedAt DateTime?

  rubricVersion String?
  promptVersion String?
  model         String?
  modelConfig   Json?

  status     SubmissionStatus?
  totalScore Float? // final score for completed runs (kept for trend readers)
  finalScore Float?
  confidence Float?
  flags      String[] @default([])
  error      String?

  /// Immutable per-criterion snapshot: score, reasoning, confidence, evidenceRefs, weight.
  criterionScores   Json?
  rawEvidence       Json?
  sanitizedEvidence Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([teamId])
  @@index([submissionId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Batch evaluation (job-based engine)
// ---------------------------------------------------------------------------

enum BatchStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
  CANCELLED
}

/// A single batch run that evaluates many teams concurrently.
model BatchRun {
  id          String      @id @default(cuid())
  status      BatchStatus @default(PENDING)
  concurrency Int         @default(3)
  totalJobs   Int         @default(0)
  createdBy   String?     // userId who triggered the batch

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  jobs BatchJob[]

  @@index([status])
  @@index([createdAt])
}

/// One team evaluation job inside a batch run.
model BatchJob {
  id         String    @id @default(cuid())
  batchRunId String
  batchRun   BatchRun  @relation(fields: [batchRunId], references: [id], onDelete: Cascade)

  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submissionId String?   // created when the job starts

  status     JobStatus @default(QUEUED)
  attempt    Int       @default(0)
  maxRetries Int       @default(2)
  error      String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([batchRunId, teamId])  // one job per team per batch
  @@index([batchRunId])
  @@index([teamId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Evaluation runs (lifecycle: DRAFT → EVALUATING → FINALIZED → PUBLISHED)
// ---------------------------------------------------------------------------

enum EvalRunStatus {
  DRAFT
  EVALUATING
  FINALIZED
  PUBLISHED
}

/// An evaluation run groups a set of team evaluations into a single versioned,
/// finalizable, and publishable unit. Only a PUBLISHED run is visible on the
/// public leaderboard.
model EvalRun {
  id          String        @id @default(cuid())
  name        String        @default("Evaluation Run")
  status      EvalRunStatus @default(DRAFT)
  createdBy   String?

  /// Snapshot of the ranking at finalization time. Immutable once written.
  /// JSON: Array<{ teamId, teamName, university, track, totalScore, rank, confidence, flags, model, promptVersion, rubricVersion, evaluatedAt }>
  snapshot    Json?

  /// Provenance captured at finalization.
  rubricVersion  String?
  promptVersion  String?
  modelVersion   String?

  /// Total teams in this run (set at finalization).
  totalTeams  Int @default(0)

  /// If the organizer confirmed finalization with unresolved issues.
  forcedFinalization Boolean @default(false)
  finalizationNote   String?

  finalizedAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Tie-break resolution
// ---------------------------------------------------------------------------

enum TieBreakMethod {
  CRITERION_HIERARCHY   // resolved by comparing criterion scores in priority order
  SECONDARY_EVALUATION  // resolved by a secondary AI tie-break evaluation
  ORGANIZER_DECISION    // resolved manually by the organizer
  UNRESOLVED            // tie could not be resolved automatically
}

/// Configurable tie-break criterion priority order.
/// If absent, the default is criterion `order` field ascending.
model TieBreakConfig {
  id         String   @id @default(cuid())

  /// Ordered array of criterion IDs — highest priority first.
  /// JSON: string[]
  priorityOrder Json

  /// Label for this configuration.
  name       String   @default("Default tie-break priority")

  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Immutable audit record for every tie-resolution decision.
/// One row per pair of teams whose tie was resolved (or flagged).
model TieBreakAudit {
  id          String          @id @default(cuid())
  evalRunId   String

  /// The teams involved in this tie group.
  tiedTeamIds String[]
  /// The final score that was tied.
  tiedScore   Float

  /// How the tie was resolved.
  method      TieBreakMethod
  /// Which criterion or secondary eval broke the tie (null for organizer/unresolved).
  resolvedBy  String?
  /// Human-readable explanation of the resolution chain.
  reasoning   String

  /// For SECONDARY_EVALUATION: the secondary eval results per team.
  /// JSON: Array<{ teamId, teamName, innovation, realWorldUsefulness, aiIntegrationQuality, projectImpact, reasoning, evidenceRefs, tieBreakScore }>
  secondaryResults Json?

  /// For ORGANIZER_DECISION: who decided and why.
  organizerNote String?
  decidedBy     String?

  /// Final ranking order for the tied teams (teamId[]).
  /// JSON: string[]
  resolvedOrder Json

  createdAt DateTime @default(now())

  @@index([evalRunId])
}

// ---------------------------------------------------------------------------
// Rubric (single, editable)
// ---------------------------------------------------------------------------

model Rubric {
  id       String      @id @default(cuid())
  name     String      @default("Default Rubric")
  criteria Criterion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Criterion {
  id          String @id @default(cuid())
  rubricId    String
  rubric      Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  name        String
  description String
  /// Integer percentage; all criteria in a rubric must sum to 100.
  weight      Int
  /// Top of the scoring scale (anchors are 1..scaleMax).
  scaleMax    Int    @default(5)
  /// JSON array of { score:Int, label:String } — anchor text per scale point.
  anchors     Json
  order       Int    @default(0)

  scores CriterionScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rubricId])
}

// ---------------------------------------------------------------------------
// Submissions & AI scores
// ---------------------------------------------------------------------------

enum SubmissionStatus {
  PENDING
  EVALUATING
  EVALUATED
  FAILED
  REVIEW_REQUIRED
}

model Submission {
  id      String           @id @default(cuid())
  teamId  String
  team    Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  repoUrl String
  status  SubmissionStatus @default(PENDING)
  error   String?

  /// Weighted total 0..100 from criterion scores (before the quality gate).
  totalScore  Float?
  /// Final score after the consistency/quality check (null if the gate failed).
  finalScore  Float?
  /// 0..1 evidence-sufficiency confidence (directness of evidence, NOT model
  /// certainty; never multiplied into scores).
  confidence  Float?
  /// Quality flags raised during the consistency check (e.g. "no-readme").
  flags       String[] @default([])
  /// AI model id used for the evaluation.
  model       String?
  /// Snapshot of the GitHub evidence bundle summary (for transparency).
  evidence    Json?
  evaluatedAt DateTime?

  scores CriterionScore[]
  events EvaluationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([status])
}

model CriterionScore {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  criterionId String
  criterion   Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  /// 1..scaleMax
  score     Int
  reasoning String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, criterionId])
  @@index([submissionId])
  @@index([criterionId])
}
