# ---------------------------------------------------------------------------
# Postgres (Vercel + Neon standard integration)
# ---------------------------------------------------------------------------
# When you add the Neon/Postgres integration on Vercel, these are injected
# automatically. Pull them locally with:  vercel env pull .env.local
#
#   POSTGRES_PRISMA_URL     -> pooled connection (PgBouncer). Used at runtime.
#   POSTGRES_URL_NON_POOLING-> direct connection. Used for migrations.
POSTGRES_PRISMA_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require&connect_timeout=15"

# ---------------------------------------------------------------------------
# Vercel Blob (pitch-deck uploads)
# ---------------------------------------------------------------------------
# Injected by the Vercel Blob integration. For local dev, pull with vercel env
# pull, or create a token in the Vercel dashboard (Storage -> Blob).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Inngest (durable background jobs)
# ---------------------------------------------------------------------------
# Local dev uses the Inngest Dev Server (npx inngest-cli@latest dev) and needs
# no keys. In production set these from the Inngest dashboard / Vercel
# integration.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# E2B (ephemeral sandboxes) + Lighthouse
# ---------------------------------------------------------------------------
E2B_API_KEY="e2b_xxxxxxxx"
# Sandbox template with git + node + Playwright browsers (see README).
E2B_TEMPLATE="base"
# Optional: Google PageSpeed Insights key (runs Lighthouse remotely).
PAGESPEED_API_KEY=""
